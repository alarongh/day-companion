                "type": "string"
              },
              "text": {
                "maxLength": 1000,
                "minLength": 1,
                "title": "Text",
                "type": "string"
              },
              "trigger": {
                "enum": [
                  "time",
                  "wake",
                  "departure",
                  "arrival",
                  "last_lesson",
                  "home",
                  "bedtime",
                  "condition",
                  "lesson_start"
                ],
                "title": "Trigger",
                "type": "string"
              },
              "time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Time"
              },
              "condition": {
                "default": "",
                "maxLength": 80,
                "title": "Condition",
                "type": "string"
              },
              "subject": {
                "default": "",
                "maxLength": 200,
                "title": "Subject",
                "type": "string"
              },
              "offset_minutes": {
                "default": 0,
                "maximum": 1440,
                "minimum": -1440,
                "title": "Offset Minutes",
                "type": "integer"
              },
              "date": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Date"
              },
              "weekdays": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 7,
                "title": "Weekdays",
                "type": "array"
              },
              "parity": {
                "default": "all",
                "enum": [
                  "all",
                  "odd",
                  "even"
                ],
                "title": "Parity",
                "type": "string"
              },
              "weeks": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 60,
                "title": "Weeks",
                "type": "array"
              },
              "expires_minutes": {
                "default": 180,
                "maximum": 1440,
                "minimum": 1,
                "title": "Expires Minutes",
                "type": "integer"
              },
              "enabled": {
                "default": true,
                "title": "Enabled",
