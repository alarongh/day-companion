        "lesson_id": {
          "title": "Lesson Id",
          "type": "string"
        },
        "change": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change"
        }
      },
      "required": [
        "day",
        "lesson_id"
      ],
      "title": "DayChange",
      "type": "object"
    },
    "Lesson": {
      "additionalProperties": false,
