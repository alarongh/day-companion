  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "day-companion/v2",
      "title": "Format",
      "type": "string"
    },
    "mode": {
      "enum": [
        "setup",
        "patch"
      ],
      "title": "Mode",
      "type": "string"
    },
    "base_revision": {
      "title": "Base Revision",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/Settings"
    },
    "places": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upsert": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9_-]{1,32}$",
                "title": "Id",
                "type": "string"
              },
              "label": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "city": {
                "default": "",
                "maxLength": 100,
                "title": "City",
                "type": "string"
              },
              "district": {
                "default": "",
                "maxLength": 100,
                "title": "District",
                "type": "string"
              },
              "latitude": {
                "anyOf": [
                  {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Latitude"
              },
              "longitude": {
                "anyOf": [
                  {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Longitude"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "title": "Place",
            "type": "object"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "garments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upsert": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 60,
                "minLength": 1,
                "title": "Name",
                "type": "string"
              },
              "minimum": {
                "maximum": 60,
                "minimum": -60,
                "title": "Minimum",
                "type": "number"
              },
              "maximum": {
                "maximum": 60,
                "minimum": -60,
                "title": "Maximum",
                "type": "number"
              },
              "waterproof": {
                "default": false,
                "title": "Waterproof",
                "type": "boolean"
              },
              "windproof": {
                "default": false,
                "title": "Windproof",
                "type": "boolean"
              },
              "enabled": {
                "default": true,
                "title": "Enabled",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "minimum",
              "maximum"
            ],
            "title": "Garment",
            "type": "object"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upsert": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Name",
                "type": "string"
              },
              "garment": {
                "maxLength": 60,
                "minLength": 1,
                "title": "Garment",
                "type": "string"
              },
              "minimum": {
                "default": -60,
                "maximum": 60,
                "minimum": -60,
                "title": "Minimum",
                "type": "number"
              },
              "maximum": {
                "default": 60,
                "maximum": 60,
                "minimum": -60,
                "title": "Maximum",
                "type": "number"
              },
              "rain": {
                "default": "any",
                "enum": [
                  "any",
                  "yes",
                  "no"
                ],
                "title": "Rain",
                "type": "string"
              },
              "wind_min": {
                "default": 0,
                "maximum": 200,
                "minimum": 0,
                "title": "Wind Min",
                "type": "number"
              },
              "scenario": {
                "default": "*",
                "maxLength": 60,
                "title": "Scenario",
                "type": "string"
              },
              "priority": {
                "default": 0,
                "maximum": 1000,
                "minimum": 0,
                "title": "Priority",
                "type": "integer"
              }
            },
            "required": [
              "name",
              "garment"
            ],
            "title": "Rule",
            "type": "object"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reminders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upsert": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9_-]{1,32}$",
